{
  "name": "rally-monad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {"node": ">=22"},
  "scripts": {
    "build": "node scripts/build-contracts.mjs && node scripts/build-app.mjs",
    "build:auth": "npm --prefix auth-client ci && npm --prefix auth-client run build",
    "test": "python3 scripts/test.py",
    "test:contracts": "node tests/community.mjs && node tests/nad-revenue.mjs",
    "test:ui": "node tests/browser.mjs",
    "audit": "npm audit --audit-level=low && npm --prefix auth-client audit --audit-level=low",
    "test:auth-dependencies": "node auth-client/test-dependencies.mjs"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "esbuild": "0.28.2",
    "ethers": "6.17.0",
    "@foundry-rs/anvil": "1.7.1",
    "playwright": "1.56.1",
    "solc": "0.8.28"
  },
  "overrides": {"solc": {"tmp": "0.2.7"}, "ethers": {"ws": "8.21.3"}}
}

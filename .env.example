# Server-side configuration. Never commit a populated .env.
RALLY_PORT=4186
RALLY_PUBLIC_ORIGIN=http://127.0.0.1:4186
RALLY_STATE_DIR=./private
RALLY_RPC_URL=https://rpc.monad.xyz
# Optional Privy integration; app ID is public, credentials stay server-side.
RALLY_PRIVY_APP_ID=
RALLY_PRIVY_CLIENT_ID=
RALLY_PRIVY_ANDROID_CLIENT_ID=
# Optional existing, independently verified Rally community factory.
RALLY_COMMUNITY_FACTORY=
# Optional deployment account public address. This grants no signing authority.
RALLY_COMMUNITY_DEPLOYER=
# Optional identity-only MetaMask bridge; disabled without a private pairing file.
RALLY_MM_CLI=mm
RALLY_MM_RUNTIME=/usr/local/bin
RALLY_MM_PLUGIN_ROOT=
RALLY_MM_WORKDIR=./private/agent-cli
RALLY_AGENT_BRIDGE_CONFIG=./private/agent-wallet-bridge.json
